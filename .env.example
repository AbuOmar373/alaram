RESEND_API_KEY=
# Must use a verified domain in Resend, e.g. onboarding@alaram.net
RESEND_FROM_EMAIL=
# Admin inbox that receives demo requests
RESEND_TO_EMAIL=

# Cloudflare Turnstile
# Public site key used by the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key used by the demo and contact forms.
TURNSTILE_SECRET_KEY=

# SEO
# Canonical site origin used for canonical URLs, hreflang, sitemap and OG images.
NEXT_PUBLIC_APP_URL=https://www.alaram.net
# Optional: verification tokens from Google Search Console / Bing Webmaster Tools
# (only the content="..." value of the HTML-tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Tap hosted checkout. All TAP_* variables stay on the server.
# Use sk_test_... with test, or sk_live_... with live.
TAP_MODE=test
TAP_SECRET_KEY=
TAP_MERCHANT_ID=
# Exact public origin; use http://localhost:3000 for local TEST payments.
TAP_SITE_URL=https://www.alaram.net
# Generate once: openssl rand -hex 32. Keep stable across deploys/instances.
TAP_CHECKOUT_SIGNING_SECRET=

# Admin dashboard and durable store (Convex deployment URLs).
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Server-only bearer secret shared with STORE_INGEST_SECRET on Convex.
STORE_INGEST_SECRET=
# ADMIN_EMAIL, JWT_PRIVATE_KEY, JWKS and SITE_URL are Convex deployment secrets.
# Provision the admin through the internal setup:bootstrapAdmin action.
