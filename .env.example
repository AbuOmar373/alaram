RESEND_API_KEY=
# Must use a verified domain in Resend, e.g. onboarding@alaram.net
RESEND_FROM_EMAIL=
# Admin inbox that receives demo requests
RESEND_TO_EMAIL=

# Cloudflare Turnstile
# Public site key used by the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key used only by POST /api/demo.
TURNSTILE_SECRET_KEY=
