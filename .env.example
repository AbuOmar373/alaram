RESEND_API_KEY=
# Must use a verified domain in Resend, e.g. onboarding@alaram.net
RESEND_FROM_EMAIL=
# Admin inbox that receives demo requests
RESEND_TO_EMAIL=

# Cloudflare Turnstile
# Public site key used by the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key used only by POST /api/demo.
TURNSTILE_SECRET_KEY=

# SEO
# Canonical site origin used for canonical URLs, hreflang, sitemap and OG images.
NEXT_PUBLIC_APP_URL=https://www.alaram.net
# Optional: verification tokens from Google Search Console / Bing Webmaster Tools
# (only the content="..." value of the HTML-tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
